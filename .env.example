DATABASE_URL=postgresql://postgres:postgres@localhost:5432/krtakan_ai
AUTH_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_IMPERSONATED_USER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_CONFIDENCE_THRESHOLD=0.85
MOCK_EXTERNAL_SERVICES=true
MAX_DRIVE_FILE_BYTES=20971520
JOB_CONCURRENCY=2

# One-time production administrator bootstrap (remove password after first deploy)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=Admin
BOOTSTRAP_ADMIN_LAST_NAME=System
