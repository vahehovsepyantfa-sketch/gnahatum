generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum Role { ADMIN LDM TEACHER }
enum Phase { DIAGNOSTIC SUMMATIVE }
enum Domain { ACADEMIC NUMERACY READING }
enum WorkStatus { DRAFT QUEUED PROCESSING NEEDS_REVIEW COMPLETED FAILED APPROVED }
enum SyncStatus { PENDING SYNCED FAILED }
model User { id String @id @default(cuid()) firstName String lastName String email String @unique passwordHash String role Role active Boolean @default(true) mustResetPassword Boolean @default(false) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt teacherProfile TeacherProfile? ldmAssignments TeacherProfile[] @relation("LdmTeachers") auditLogs AuditLog[] reviews HumanReview[] comments LdmComment[] approvals Approval[] sheets TeacherAnalysisSheet[] }
model Cohort { id String @id @default(cuid()) name String @unique active Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt teachers TeacherProfile[] @@index([active]) }
model TeacherProfile { id String @id @default(cuid()) userId String @unique cohortId String ldmId String subject String grade String user User @relation(fields:[userId],references:[id],onDelete:Cascade) cohort Cohort @relation(fields:[cohortId],references:[id]) ldm User @relation("LdmTeachers",fields:[ldmId],references:[id]) sheet TeacherAnalysisSheet? submissions Submission[] @@index([cohortId]) @@index([ldmId]) }
model AssessmentTemplate { id String @id @default(cuid()) title String phase Phase domain Domain subject String grade String answerKeyDriveUrl String answerKeyDriveFileId String rubricDriveUrl String? rubricDriveFileId String? instructions String? maxScore Float active Boolean @default(true) promptVersion String @default("v1") createdAt DateTime @default(now()) updatedAt DateTime @updatedAt submissions Submission[] @@unique([phase,domain,subject,grade,active]) @@index([active,phase,domain,subject,grade]) }
model TeacherAnalysisSheet { id String @id @default(cuid()) teacherId String @unique sheetUrl String spreadsheetId String connectedById String connectedAt DateTime @default(now()) updatedAt DateTime @updatedAt teacher TeacherProfile @relation(fields:[teacherId],references:[id],onDelete:Cascade) connectedBy User @relation(fields:[connectedById],references:[id]) }
model Submission { id String @id @default(cuid()) teacherId String assessmentTemplateId String phase Phase domain Domain status WorkStatus @default(DRAFT) idempotencyKey String @unique createdAt DateTime @default(now()) updatedAt DateTime @updatedAt teacher TeacherProfile @relation(fields:[teacherId],references:[id]) template AssessmentTemplate @relation(fields:[assessmentTemplateId],references:[id]) works StudentWork[] approvals Approval[] @@index([teacherId,status]) @@index([assessmentTemplateId]) }
model StudentWork { id String @id @default(cuid()) submissionId String driveUrl String driveFileId String fileName String? studentName String? status WorkStatus @default(QUEUED) score Float? maxScore Float? percentage Float? overallConfidence Float? aiResult Json? syncStatus SyncStatus @default(PENDING) syncError String? analyzedAt DateTime? updatedAt DateTime @updatedAt submission Submission @relation(fields:[submissionId],references:[id],onDelete:Cascade) questions QuestionAnalysis[] reviews HumanReview[] comments LdmComment[] @@unique([submissionId,driveFileId]) @@index([submissionId,status]) }
model QuestionAnalysis { id String @id @default(cuid()) studentWorkId String questionNumber String studentAnswer String? teacherCorrectionDetected Boolean teacherCorrection String? expectedAnswer String? isCorrect Boolean scoreAwarded Float maxScore Float confidence Float reviewRequired Boolean reason String? studentWork StudentWork @relation(fields:[studentWorkId],references:[id],onDelete:Cascade) @@index([studentWorkId]) }
model HumanReview { id String @id @default(cuid()) studentWorkId String questionAnalysisId String? originalValue Json correctedValue Json correctedById String correctedAt DateTime @default(now()) resolved Boolean @default(true) studentWork StudentWork @relation(fields:[studentWorkId],references:[id]) correctedBy User @relation(fields:[correctedById],references:[id]) @@index([studentWorkId]) }
model LdmComment { id String @id @default(cuid()) studentWorkId String @unique authorId String content String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt studentWork StudentWork @relation(fields:[studentWorkId],references:[id]) author User @relation(fields:[authorId],references:[id]) }
model Approval { id String @id @default(cuid()) submissionId String teacherId String phase Phase approvedById String approvedAt DateTime @default(now()) comments String? finalMetrics Json generatedDocument GeneratedDocument? submission Submission @relation(fields:[submissionId],references:[id]) approvedBy User @relation(fields:[approvedById],references:[id]) @@unique([submissionId]) @@index([teacherId,phase]) }
model GeneratedDocument { id String @id @default(cuid()) approvalId String @unique driveFileId String? url String? status String error String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt approval Approval @relation(fields:[approvalId],references:[id]) }
model GlobalResource { id String @id @default(cuid()) title String description String? url String targetRoles Role[] active Boolean @default(true) displayOrder Int @default(0) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model AuditLog { id String @id @default(cuid()) actorUserId String? action String entityType String entityId String? metadata Json? createdAt DateTime @default(now()) actor User? @relation(fields:[actorUserId],references:[id]) @@index([actorUserId,createdAt]) @@index([entityType,entityId]) }
model AppSetting { key String @id value Json updatedAt DateTime @updatedAt }
model PasswordResetToken { id String @id @default(cuid()) userId String tokenHash String @unique expiresAt DateTime usedAt DateTime? createdAt DateTime @default(now()) @@index([userId]) }
model BackgroundJob { id String @id @default(cuid()) type String entityId String status String attempts Int @default(0) lastError String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([type,entityId]) @@index([status]) }
